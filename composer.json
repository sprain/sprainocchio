{
    "name": "sprain/sprainocchio",
    "description": "A simple blog engine",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "twig/twig": "^3.21",
        "erusev/parsedown": "^1.8",
        "symfony/finder": "^8.0",
        "pimple/pimple": "^3.5",
        "symfony/yaml": "^8.0"
    },
    "bin": [
        "bin/sprainocchio"
    ],
    "autoload": {
        "psr-4": {
            "Sprainocchio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sprainocchio\\Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Manuel Reinhard",
            "email": "manu@sprain.ch"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit"
    }
}
