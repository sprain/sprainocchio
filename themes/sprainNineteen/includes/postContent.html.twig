<article class="post-{{ post.type }}">
    <p>
        <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|date('d. F Y') }}</time>
        {% if post.author %} | by {{ post.author }}{% endif %}
        {% if post.tags|length %} |
            <span id="tags">
                {% for tag in post.tags %}
                    <a href="{{ baseUrl }}tags/{{ tag|urlize }}/">{{ tag }}</a>{% if not loop.last %} {% endif %}
                {% endfor %}
            </span>
        {% endif %}
    </p>
    {# A theme can render every post type its own way; types without a snippet look like articles #}
    {% include ['includes/types/' ~ post.type ~ '.html.twig', 'includes/types/article.html.twig'] %}
</article>